{
  "name": "sushi-express-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Suite E2E adaptativa con Playwright + DeepSeek LLM sobre la SPA SushiExpress (Angular 22)",
  "scripts": {
    "start:api": "node server/server.mjs",
    "start:app": "npm --prefix app run start -- --proxy-config ../proxy.conf.json",
    "start:all": "node scripts/dev.mjs",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "report": "playwright show-report",
    "generate:cases": "tsx scripts/generar-casos.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.0.0",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.3",
    "typescript": "^5.8.0"
  }
}
